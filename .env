# Untuk development lokal dengan `vercel dev`.
# Salin file ini menjadi ".env" (vercel dev otomatis membacanya).
#
# Di production (setelah deploy), JANGAN pakai file ini — isi variabel yang
# sama lewat Vercel Dashboard: Project → Settings → Environment Variables,
# atau lewat CLI: vercel env add MONGODB_URI

# Connection string MongoDB Atlas (atau MongoDB lain yang bisa diakses publik)
# Contoh: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://Vercel-Admin-mongo-vercel-hris:dmLmOhlEWtjTnnOU@mongo-vercel-hris.46jukaz.mongodb.net/?retryWrites=true&w=majority"

# Nama database (dibuat otomatis kalau belum ada)
DB_NAME=hris

# (Opsional) proteksi sederhana — kalau diisi, request ke /api/state wajib
# menyertakan header x-api-key dengan nilai yang sama.
API_KEY=
